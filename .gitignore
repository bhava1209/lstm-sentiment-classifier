# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Model artifacts and weights (can be re-generated by running train.py)
models/*.keras
models/*.h5
models/*.pickle
!models/.gitkeep

# Large dataset archives and raw files
data/raw/*.csv
data/raw/*.tar.gz
data/raw/*.zip
data/processed/*.npy
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results and figures are tracked so they appear on GitHub
# (large training data remains ignored)

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
